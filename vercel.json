      "permanent": true
    },
    {
      "source": "/speech-delay-support",
      "destination": "/speech-therapist-for-children",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/app"
    }
  ]
}
