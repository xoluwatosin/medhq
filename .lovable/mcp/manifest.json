      {
        "name": "db_tables",
        "title": "List admin tables",
        "description": "List the admin database tables reachable over MCP, optionally with a live row count per table. Read-only discovery: use it to see what db_select can target. There is no generic write tool on this server.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "with_counts": {
              "type": "boolean",
              "description": "Also return an exact row count per table (slower)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "db_select",
        "title": "Read any admin table",
        "description": "Read rows from any admin table with column selection, filters, ordering and paging. Embedded relations are supported in `columns` using PostgREST syntax, e.g. 'id,full_name,mu_documents(label,url,verified)'. Runs under the signed-in admin's RLS scope.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "table": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Table name, e.g. 'mu_people'. Use db_tables to discover."
            },
            "columns": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "PostgREST select string. Default '*'."
            },
            "filters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "column": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "op": {
                    "type": "string",
                    "enum": [
                      "eq",
                      "neq",
                      "gt",
                      "gte",
                      "lt",
                      "lte",
                      "like",
                      "ilike",
                      "is",
                      "in",
                      "contains"
                    ],
                    "default": "eq"
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "number"
                          ]
                        }
                      }
                    ],
                    "description": "Value to compare. Use an array with op 'in'. Use null with op 'is'."
                  }
                },
                "required": [
                  "column",
                  "value"
                ],
                "additionalProperties": false
              },
              "maxItems": 20,
              "description": "Filters combined with AND."
            },
            "or": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "description": "Optional PostgREST OR expression, e.g. \"full_name.ilike.%ada%,email.ilike.%ada%\"."
            },
            "order_by": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Column to order by."
            },
            "ascending": {
              "type": "boolean",
              "description": "Order direction (default false = newest/highest first)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "description": "Max rows (default 50, cap 500)."
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "description": "Rows to skip for paging."
            },
            "count": {
              "type": "boolean",
              "description": "Also return the total matching row count."
            }
          },
          "required": [
            "table"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "storage_browse",
        "title": "Browse stored files",
        "description": "List file names in a storage bucket ('applications', 'blog-images', 'creator-uploads'). Listing never returns file contents or links. A signed URL is minted only when sign=true AND a written reason is supplied, and only for the single file named in file, never for a whole folder. Candidate documents are private: do not mint a link unless an admin has asked for that specific document. Runs under the signed-in admin's storage policies and every signing is recorded in the reason field of the response.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "bucket": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "description": "Bucket name."
            },
            "path": {
              "type": "string",
              "maxLength": 300,
              "description": "Folder prefix inside the bucket (default root)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Max entries (default 50)."
            },
            "search": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Filename search term."
            },
            "sign": {
              "type": "boolean",
              "description": "Mint a 1-hour signed URL for one named file. Requires both file and reason."
            },
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "Exact file name inside path to sign. Required when sign=true."
            },
            "reason": {
              "type": "string",
              "minLength": 12,
              "maxLength": 300,
              "description": "Why this specific document needs to be opened. Required when sign=true."
            }
          },
          "required": [
            "bucket"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
