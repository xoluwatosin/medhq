        },
        "outputSchema": null
      },
      {
        "name": "set_opportunity_criteria",
        "title": "Set opportunity match criteria",
        "description": "Set the hard filters and requirement facets on an opportunity so the deterministic matcher can rank against it. Without these an opportunity is unrankable. Facet codes must come from the controlled vocabulary; anything outside it is rejected, never stored. Replaces the facets for the opportunity when facets are supplied.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "opportunity_id": {
              "type": "string",
              "format": "uuid"
            },
            "professions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 20,
              "description": "Acceptable professions, e.g. ['Registered Nurse','Nurse/Midwife']."
            },
            "states": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 20,
              "description": "Acceptable states, without the word 'State' (e.g. 'Oyo')."
            },
            "lgas": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 40
            },
            "min_years": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 40
                },
                {
                  "type": "null"
                }
              ]
            },
            "requires_licence": {
              "type": "boolean",
              "description": "Deprecated shorthand. Prefer min_licence_evidence."
            },
            "requires_right_to_work": {
              "type": "boolean",
              "description": "Deprecated shorthand. Prefer min_right_to_work_evidence."
            },
            "min_licence_evidence": {
              "type": "string",
              "enum": [
                "none",
                "self_declared",
                "documented",
                "verified"
              ],
              "description": "Minimum evidence tier for a licence. none = ignore. self_declared = the candidate ticked yes on a form, nobody checked it. documented = a document is on file. verified = an admin reviewed and passed the document. We cannot check any external register, so 'verified' means an internal document review only."
            },
            "min_right_to_work_evidence": {
              "type": "string",
              "enum": [
                "none",
                "self_declared",
                "documented",
                "verified"
              ],
              "description": "Minimum evidence tier for right to work. Same ladder as min_licence_evidence."
            },
            "facets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "facet_type": {
                    "type": "string",
                    "enum": [
                      "specialty",
                      "setting",
                      "skill",
                      "seniority",
                      "availability",
                      "language",
                      "patient_group"
                    ]
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requirement": {
                    "type": "string",
                    "enum": [
                      "required",
                      "desirable"
                    ]
                  }
                },
                "required": [
                  "facet_type",
                  "code",
                  "requirement"
                ],
                "additionalProperties": false
              },
              "maxItems": 60,
              "description": "Requirement facets from the controlled vocabulary. Supplying this replaces existing facets."
            }
          },
          "required": [
            "opportunity_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
